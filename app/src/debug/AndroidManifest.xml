<!--
Debug builds, and the release-like staging build (app/build.gradle.kts takes this file for it too): merged into no
release or store build.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
        Writes the log Download log serves to the app's own storage for tools/pull-tv-log.ps1 (AdbLogReceiver).
        Exported for adb, but only a sender holding DUMP (the shell, the system) reaches it, never another app.
        -->
        <receiver
            android:name="io.github.mbustos27.nixie.tv.diagnostics.AdbLogReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.mbustos27.nixie.tv.debug.WRITE_LOG" />
            </intent-filter>
        </receiver>
        <!--
        Hands that file to the script through adb's content command (AdbLogProvider): run-as reads the app's storage
        only on a debuggable build, and staging is not one. Only a caller holding DUMP reaches it.
        -->
        <provider
            android:name="io.github.mbustos27.nixie.tv.diagnostics.AdbLogProvider"
            android:authorities="${applicationId}.adblog"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
