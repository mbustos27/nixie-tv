<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher banner: 320 x 180 px at xhdpi (160 x 90 dp), the app name in the image as the TV icon guidelines ask.
     NIXIE in five glass nixie tubes over a dusk sky. Own artwork: geometric strokes, no font and no outside asset.
     The glow is stacked strokes of falling alpha (the plan's neon rule: never blur). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="160dp"
    android:height="90dp"
    android:viewportWidth="320"
    android:viewportHeight="180">

    <!-- dusk sky: Night2 at the top, Maroon low down -->
    <path android:pathData="M0,0h320v180h-320z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="180">
                <item android:offset="0" android:color="#FF12040A" />
                <item android:offset="0.62" android:color="#FF2A0A18" />
                <item android:offset="1" android:color="#FF500723" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- horizon glow -->
    <path android:pathData="M0,150h320v30h-320z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="150"
                android:endX="0"
                android:endY="180">
                <item android:offset="0" android:color="#00EC6A79" />
                <item android:offset="1" android:color="#66EC6A79" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- the tubes: faint glass with a lit edge -->
    <path
        android:fillColor="#14FFF4EE"
        android:strokeColor="#55F7AA9C"
        android:strokeWidth="1.5"
        android:pathData="M34,52 A22,22 0 0,1 78,52 V120 Q78,126 72,126 H40 Q34,126 34,120 Z M86,52 A22,22 0 0,1 130,52 V120 Q130,126 124,126 H92 Q86,126 86,120 Z M138,52 A22,22 0 0,1 182,52 V120 Q182,126 176,126 H144 Q138,126 138,120 Z M190,52 A22,22 0 0,1 234,52 V120 Q234,126 228,126 H196 Q190,126 190,120 Z M242,52 A22,22 0 0,1 286,52 V120 Q286,126 280,126 H248 Q242,126 242,120 Z" />
    <!-- the sockets -->
    <path
        android:fillColor="#FF500723"
        android:pathData="M30,126 h260 v8 a3,3 0 0,1 -3,3 h-254 a3,3 0 0,1 -3,-3 z" />

    <!-- N I X I E: outer glow, inner glow, orange filament, hot core -->
    <path
        android:strokeColor="#26FF7A50"
        android:strokeWidth="14"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M44,106 V50 L68,106 V50 M100,50 H116 M108,50 V106 M100,106 H116 M148,50 L172,106 M172,50 L148,106 M204,50 H220 M212,50 V106 M204,106 H220 M276,50 H252 V106 H276 M252,78 H270" />
    <path
        android:strokeColor="#59FF7A50"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M44,106 V50 L68,106 V50 M100,50 H116 M108,50 V106 M100,106 H116 M148,50 L172,106 M172,50 L148,106 M204,50 H220 M212,50 V106 M204,106 H220 M276,50 H252 V106 H276 M252,78 H270" />
    <path
        android:strokeColor="#FFFF7A50"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M44,106 V50 L68,106 V50 M100,50 H116 M108,50 V106 M100,106 H116 M148,50 L172,106 M172,50 L148,106 M204,50 H220 M212,50 V106 M204,106 H220 M276,50 H252 V106 H276 M252,78 H270" />
    <path
        android:strokeColor="#FFFFE3D2"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M44,106 V50 L68,106 V50 M100,50 H116 M108,50 V106 M100,106 H116 M148,50 L172,106 M172,50 L148,106 M204,50 H220 M212,50 V106 M204,106 H220 M276,50 H252 V106 H276 M252,78 H270" />
</vector>
